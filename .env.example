# =============================================================================
# Operam — variables de entorno (copiar a `.env` y ajustar)
# Nunca subir `.env` real al repositorio.
# =============================================================================

# --- Frontend (Vite) ---
# URL base del API (sin slash final). Alias soportado: VITE_API_BASE_URL
VITE_API_URL=http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
# URL pública del frontend (ligas de portal RF-7.1 / instance-api)
FRONTEND_URL=http://localhost:5173

# --- Base de datos MySQL 8 (Phinx + Capsule Eloquent) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=operam_contratos
DB_USER=root
DB_PASS=

# --- Seguridad JWT (operam/servicios · LoginService / AppService) ---
# Usar una llave aleatoria larga (≥ 256 bits). Nunca reutilizar en producción.
JWT_TOKEN_KEY=cambiar_por_llave_segura_256_bits
JWT_TOKEN_ISSUER=http://localhost:8080/
DEF_EXPIRATION_TIME=3600

# --- Servicios externos (Bloque C · RNF-8 cofre de secretos) ---
# En MySQL (`external_service_configs.secret_refs_json`) solo se guarda el NOMBRE de estas
# variables; el valor real vive únicamente aquí o en Secret Manager. El panel
# Configuración → Servicios externos muestra "Referencia configurada" si la variable existe.
# Alternativa para Docker/GCP: definir `<NOMBRE>_FILE=/ruta/al/secreto` en lugar del valor.
# Contraseña del usuario SMTP (avisos de cobranza / Magic Links)
SMTP_PASSWORD_REF=
# API key del ERP Master (control de instancias)
ERP_MASTER_API_KEY_REF=
# URL del Incoming Webhook de Slack para alertas del outbox (RNF-12)
SLACK_OUTBOX_WEBHOOK_REF=
# Token de consulta de Banxico SIE (tipo de cambio FIX)
BANXICO_SIE_TOKEN_REF=
# Secreto compartido del job/worker de outbox en GCP
GCP_JOB_SECRET_REF=
