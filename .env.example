# =============================================================================
# Operam — variables de entorno (copiar a `.env` y ajustar)
# Nunca subir `.env` real al repositorio.
# =============================================================================

# --- Frontend (Vite) ---
# URL base del API (sin slash final). Alias soportado: VITE_API_BASE_URL
VITE_API_URL=http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
# Preferir Mockup en UI al arrancar (el switch Mockup|API Real también controla esto)
VITE_USE_MOCK_DATA=true

# --- Base de datos MySQL 8 (Phinx + Capsule Eloquent) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=operam_contratos
DB_USER=root
DB_PASS=

# --- Seguridad JWT (operam/servicios · LoginService / AppService) ---
# Usar una llave aleatoria larga (≥ 256 bits). Nunca reutilizar en producción.
JWT_TOKEN_KEY=cambiar_por_llave_segura_256_bits
JWT_TOKEN_ISSUER=http://localhost:8080/
DEF_EXPIRATION_TIME=3600
